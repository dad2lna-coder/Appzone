{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memorandum Builder",
  "version": "0.1.0",
  "identifier": "com.dad2lnacoder.memorandumbuilder",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Memorandum Builder",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
