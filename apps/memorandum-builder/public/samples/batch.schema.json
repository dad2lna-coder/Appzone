{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.memorandum-builder/batch.schema.json",
  "title": "Memorandum batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["templateId", "records"],
  "properties": {
    "batchId": { "type": "string", "minLength": 1 },
    "templateId": { "type": "string", "minLength": 1 },
    "allOrNothing": {
      "type": "boolean",
      "description": "When true, generation stops unless every included record is valid. Invalid records never block valid ones when this is false."
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "recordId": { "type": "string" },
          "airport": { "type": "string" },
          "location": { "type": "string" },
          "effectiveDate": { "type": "string", "description": "ISO date YYYY-MM-DD" },
          "dateRange": { "type": "string", "description": "YYYY-MM-DD|YYYY-MM-DD" },
          "bidCycle": { "type": "string" },
          "recipients": { "type": "string" },
          "cc": { "type": "string" },
          "issuingOfficial": { "type": "string", "description": "Personnel id or display name" },
          "memoDate": { "type": "string" },
          "additionalNotes": { "type": "string" }
        }
      }
    }
  }
}
